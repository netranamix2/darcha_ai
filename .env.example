# ---- copy to .env (never commit .env) ----
DATABASE_URL=postgresql+asyncpg://edu:edu@localhost:5432/darcha

# LLM (Claude). All calls go through backend/app/llm/client.py
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Retrieval models (run locally; GPU if available)
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANKER=1
DEVICE=auto

# Level thresholds (tune with scripts/run_eval.py)
GREEN_MIN_CONFIDENCE=0.8
RED_MAX_CONFIDENCE=0.5
VEC_SIM_FLOOR=0.40
VEC_SIM_FULL=0.58

# Tickets: verify the terms in the Law "On appeals of individuals and legal entities" (lex.uz)
TICKET_DUE_DAYS=15
TICKET_DUE_DAYS_HIGH=5
HOTLINES=1006

# Panel auth
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173

# Telegram: polling works without a public URL; webhook needs PUBLIC_BASE_URL (https)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
TG_ALERT_CHAT_ID=

# Instagram (Meta app in development mode). Leave empty to use only the simulator.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_IG_USER_ID=
ENABLE_SIMULATOR=1

# Optional voice messages
ENABLE_VOICE=0
ASR_MODEL=navai-uz/whisper-small-uzbek
